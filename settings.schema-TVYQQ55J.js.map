{
    "type": "object",
    "description": "Customisable settings for the visitor-kiosk app",
    "properties": {
        "name": {
            "type": "string",
            "description": "Application name sent with PlaceOS API requests. Falls back to `short_name`"
        },
        "short_name": {
            "type": "string",
            "description": "Prefix for console log messages. Also used as the API application name when `name` is not set"
        },
        "default_route": {
            "type": "string",
            "description": "Route to redirect to after the application has initialised. Defaults to `welcome`"
        },
        "inactivity_timeout_secs": {
            "type": "number",
            "description": "Number of seconds with no touch, click or key press before the kiosk returns to the welcome page. The welcome and setup pages stay open. Set to `0` to turn off the reset. Defaults to `120`"
        },
        "logo_light": {
            "type": "string",
            "description": "URL of the logo to display when the application is using a light theme"
        },
        "logo_dark": {
            "type": "string",
            "description": "URL of the logo to display when the application is using a dark theme"
        },
        "welcome_background": {
            "type": "string",
            "description": "URL of the background image displayed on the welcome, check-in and registration pages"
        },
        "welcome_message": {
            "type": "string",
            "description": "HTML message displayed on the welcome page. Falls back to a translated default message when unset"
        },
        "hide_building_image": {
            "type": "boolean",
            "description": "Whether to hide the building image panel on the welcome, check-in and registration pages"
        },
        "hide_explore": {
            "type": "boolean",
            "description": "Whether to hide the explore (building map) button on the welcome page"
        },
        "allow_self_registration": {
            "type": "boolean",
            "description": "Whether walk-up visitors can register themselves. Shows the register button on the welcome page"
        },
        "allow_registration_time_options": {
            "type": "boolean",
            "description": "Whether the self-registration form shows time options (all-day checkbox and visit duration field)"
        },
        "allow_pass_number": {
            "type": "boolean",
            "description": "Whether to show a visitor pass number field on the registration and check-in details forms"
        },
        "allow_user_photo": {
            "type": "boolean",
            "description": "Whether visitors are asked to take a photo of themselves during check-in"
        },
        "allow_printing_label": {
            "type": "boolean",
            "description": "Whether a visitor badge label can be printed after check-in. Defaults to `true`"
        },
        "allow_beverages": {
            "type": "boolean",
            "description": "Whether visitors can select beverage (catering) preferences after checking in. Only applies to visitors with a linked event or when `standalone_visitor_location` is set"
        },
        "visitor_label_size": {
            "type": "object",
            "description": "Dimensions of the printed visitor badge label",
            "properties": {
                "width": {
                    "type": "number",
                    "description": "Width of the printed label in `em`, relative to the font size set by `scale`. Defaults to `25`"
                },
                "height": {
                    "type": "number",
                    "description": "Height of the printed label in `em`, relative to the font size set by `scale`. Defaults to `15`"
                },
                "scale": {
                    "type": "number",
                    "description": "Font size of the printed label in millimetres. A larger value also makes the label wider and higher. Defaults to `4`"
                }
            }
        },
        "checked_in_template": {
            "type": "string",
            "description": "HTML template displayed after a successful check-in. Supports the placeholders {{ title }}, {{ room_name }}, {{ host_name }}, {{ host_email }}, {{ visitor_name }}, {{ visitor_email }}, {{ can_use_lift }}, {{ date }} and {{ time }}"
        },
        "standalone_visitor_location": {
            "type": "string",
            "description": "Location associated with standalone visitors (visitors without a linked calendar event). When set, standalone visitors are also offered beverage preferences after check-in"
        },
        "induction_enabled": {
            "type": "boolean",
            "description": "Whether to show an induction acceptance step in the check-in and registration flows. Requires `induction_details` to also be set"
        },
        "induction_details": {
            "type": "string",
            "description": "Induction text displayed to visitors for acceptance. The induction step is hidden when this is unset"
        },
        "induction_after_details": {
            "type": "boolean",
            "description": "Whether the induction step is shown after the visitor details form instead of before it"
        },
        "visitors": {
            "type": "object",
            "description": "Visitor booking settings. These override the matching `bookings` settings",
            "properties": {
                "allow_all_day": {
                    "type": "boolean",
                    "description": "Whether the all-day option is available on the self-registration form. Overrides `bookings.allow_all_day`"
                },
                "max_duration": {
                    "type": "number",
                    "description": "Maximum visit duration in minutes selectable on the self-registration form. Overrides `bookings.max_duration`. Defaults to `180`"
                }
            }
        },
        "bookings": {
            "type": "object",
            "description": "General booking settings used as a fallback for the matching `visitors` settings",
            "properties": {
                "allow_all_day": {
                    "type": "boolean",
                    "description": "Whether the all-day option is available on the self-registration form"
                },
                "max_duration": {
                    "type": "number",
                    "description": "Maximum visit duration in minutes selectable on the self-registration form. Defaults to `180`"
                }
            }
        },
        "explore": {
            "type": "object",
            "description": "Data associated with map rendering on the explore page",
            "properties": {
                "colors": {
                    "type": "object",
                    "description": "Mapping of keys to their color values. Keys are usually in the format `<type>-<status>`",
                    "additionalProperties": { "type": "string" }
                },
                "search_enabled": {
                    "type": "boolean",
                    "description": "Whether to show the search bar on the explore page. The search bar is hidden when not set"
                },
                "show_legend": {
                    "type": "boolean",
                    "description": "Whether to show the legend on the explore page. The legend is hidden only when set to `false`"
                },
                "show_booking_qr": {
                    "type": "boolean",
                    "description": "Whether a room booking shows a QR code to book on a personal device, instead of the booking form"
                },
                "disable": {
                    "$ref": "#/$defs/map_layers",
                    "description": "Map layers to turn off: features, actions, labels and styles"
                },
                "disable_features": {
                    "$ref": "#/$defs/map_layers",
                    "description": "Map layers whose features are turned off"
                },
                "disable_actions": {
                    "$ref": "#/$defs/map_layers",
                    "description": "Map layers whose click actions are turned off"
                },
                "disable_labels": {
                    "$ref": "#/$defs/map_layers",
                    "description": "Map layers whose labels are turned off"
                },
                "disable_styles": {
                    "$ref": "#/$defs/map_layers",
                    "description": "Map layers whose styles are turned off"
                },
                "hide_device_fields": {
                    "type": "array",
                    "description": "Fields to hide in device tooltips",
                    "items": {
                        "type": "string",
                        "enum": [
                            "mac",
                            "manufacturer",
                            "os",
                            "ssid",
                            "username",
                            "user"
                        ]
                    }
                },
                "use_zone_polygons": {
                    "type": "boolean",
                    "description": "Whether to draw zone areas with their polygon data"
                },
                "show_zone_labels": {
                    "type": "boolean",
                    "description": "Whether to show labels for zone areas"
                },
                "show_zone_sensor_info": {
                    "type": "boolean",
                    "description": "Whether to show sensor values in zone area labels"
                },
                "area_count_key": {
                    "type": "string",
                    "description": "Key of the zone area value to use as the people count. Defaults to `count`"
                }
            }
        },
        "desks": {
            "type": "object",
            "description": "Desk settings for the explore page",
            "properties": {
                "enable_maps": {
                    "type": "boolean",
                    "description": "Whether people can book desks from the map. On unless set to `false`"
                },
                "show_users": {
                    "type": "boolean",
                    "description": "Whether desk tooltips show the name of the person at the desk. On unless set to `false`"
                }
            }
        },
        "use_24_hour_time": {
            "type": "boolean",
            "description": "Whether to show times with a 24-hour clock"
        },
        "use_imperial_units": {
            "type": "boolean",
            "description": "Whether zone sensor labels show temperatures in Fahrenheit"
        },
        "chat": {
            "type": "object",
            "description": "Settings for the chat assistant",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Whether to show the global chat widget. Off when not set"
                }
            }
        },
        "environment_bar": {
            "type": "string",
            "description": "CSS colour for thin identifier bars at the top and bottom of the app. Leave unset to hide the bars"
        },
        "banner": {
            "$ref": "#/$defs/banner"
        },
        "locales": {
            "type": "array",
            "description": "List of locales available in the language selector on the welcome page. The selector is hidden when fewer than two locales are set",
            "items": { "$ref": "#/$defs/locale" }
        }
    },
    "$defs": {
        "map_layers": {
            "type": "array",
            "description": "Map layer names, such as `devices`, `desks`, `lockers`, `parking`, `spaces`, `spaces-presence` and `zones`",
            "items": { "type": "string" }
        },
        "banner": {
            "type": "object",
            "description": "Message banner shown at the top of the app. The user can close it",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique ID for the banner. A closed banner stays hidden until the ID changes"
                },
                "type": {
                    "type": "string",
                    "enum": ["info", "warn", "error"],
                    "description": "Colour style for the banner. Defaults to `info`"
                },
                "content": {
                    "type": "string",
                    "description": "Message text to show in the banner"
                }
            }
        },
        "locale": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Locale code, e.g. `en-AU` or `fr`"
                },
                "name": {
                    "type": "string",
                    "description": "Translation key for the locale's display name, e.g. `LANGUAGE.ENGLISH`"
                },
                "local": {
                    "type": "string",
                    "description": "Name of the locale in its own language, e.g. `Français`"
                },
                "flag": {
                    "type": "string",
                    "description": "Flag emoji displayed next to the locale name"
                }
            }
        }
    }
}
