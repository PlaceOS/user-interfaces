{
    "name": "control",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/control/src",
    "prefix": "placeos",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "options": {
                "baseHref": "./",
                "outputPath": "dist/apps/control",
                "index": "apps/control/src/index.html",
                "polyfills": [],
                "tsConfig": "apps/control/tsconfig.app.json",
                "fileReplacements": [
                    {
                        "replace": "libs/common/src/lib/settings.ts",
                        "with": "apps/control/src/environments/settings.ts"
                    }
                ],
                "assets": [
                    "apps/control/src/favicon.ico",
                    "apps/control/src/assets",
                    {
                        "glob": "**",
                        "input": "shared/assets",
                        "output": "/assets/"
                    },
                    {
                        "glob": "*.woff2",
                        "input": "node_modules/material-symbols",
                        "output": "/assets/"
                    },
                    {
                        "glob": "oauth-resp.html",
                        "input": "node_modules/@placeos/ts-client/dist/",
                        "output": "/"
                    },
                    "apps/control/src/manifest.webmanifest"
                ],
                "styles": [
                    "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                    "apps/control/src/styles.css",
                    "shared/styles/application.css"
                ],
                "scripts": [],
                "extractLicenses": false,
                "sourceMap": true,
                "optimization": false,
                "namedChunks": true,
                "browser": "apps/control/src/main.ts"
            },
            "configurations": {
                "staging": {
                    "optimization": true,
                    "fileReplacements": [
                        {
                            "replace": "apps/control/src/environments/environment.ts",
                            "with": "apps/control/src/environments/environment.mobile.ts"
                        },
                        {
                            "replace": "libs/common/src/lib/settings.ts",
                            "with": "apps/control/src/environments/settings.ts"
                        }
                    ],
                    "serviceWorker": "apps/control/ngsw-config.json"
                },
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "libs/mocks/src/index.ts",
                            "with": "libs/mocks/src/empty.ts"
                        },
                        {
                            "replace": "apps/control/src/environments/environment.ts",
                            "with": "apps/control/src/environments/environment.prod.ts"
                        },
                        {
                            "replace": "libs/common/src/lib/settings.ts",
                            "with": "apps/control/src/environments/settings.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "2mb",
                            "maximumError": "5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "6kb",
                            "maximumError": "10kb"
                        }
                    ],
                    "serviceWorker": "apps/control/ngsw-config.json"
                },
                "mobile": {
                    "fileReplacements": [
                        {
                            "replace": "libs/mocks/src/index.ts",
                            "with": "libs/mocks/src/empty.ts"
                        },
                        {
                            "replace": "apps/control/src/environments/environment.ts",
                            "with": "apps/control/src/environments/environment.prod.ts"
                        },
                        {
                            "replace": "libs/common/src/lib/settings.ts",
                            "with": "apps/control/src/environments/settings.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": true,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "serviceWorker": false,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "2mb",
                            "maximumError": "5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "6kb",
                            "maximumError": "10kb"
                        }
                    ]
                }
            }
        },
        "serve": {
            "executor": "@angular/build:dev-server",
            "continuous": true,
            "options": {
                "proxyConfig": "config/proxy.conf.js",
                "buildTarget": "control:build"
            },
            "configurations": {
                "production": {
                    "buildTarget": "control:build:production"
                }
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"]
        },
        "test": {
            "executor": "@angular/build:unit-test",
            "outputs": ["{workspaceRoot}/coverage/apps/control"],
            "options": {
                "tsConfig": "apps/control/tsconfig.spec.json",
                "setupFiles": ["apps/control/src/test-setup.ts"],
                "isolate": true,
                "watch": false,
                "buildTarget": "control:test-build:development"
            }
        },
        "test-build": {
            "executor": "@angular/build:application",
            "options": {
                "outputPath": "dist/apps/control-test",
                "browser": "apps/control/src/main.ts",
                "tsConfig": "apps/control/tsconfig.spec.json",
                "polyfills": []
            },
            "configurations": {
                "development": {}
            }
        },
        "mobile:sync:android": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "parallel": false,
                "commands": [
                    {
                        "command": "bunx nx build control --configuration=mobile"
                    },
                    {
                        "command": "node tools/capacitor/run.mjs sync control android"
                    }
                ]
            }
        },
        "mobile:sync:ios": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "parallel": false,
                "commands": [
                    {
                        "command": "bunx nx build control --configuration=mobile"
                    },
                    {
                        "command": "node tools/capacitor/run.mjs sync control ios"
                    }
                ]
            }
        },
        "mobile:open:android": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["mobile:sync:android"],
            "options": {
                "command": "node tools/capacitor/run.mjs open control android"
            }
        },
        "mobile:open:ios": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["mobile:sync:ios"],
            "options": {
                "command": "node tools/capacitor/run.mjs open control ios"
            }
        },
        "mobile:build:android": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["mobile:sync:android"],
            "options": {
                "command": "node tools/capacitor/run.mjs build control android"
            }
        },
        "mobile:build:ios": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["mobile:sync:ios"],
            "options": {
                "command": "node tools/capacitor/run.mjs build control ios"
            }
        },
        "mobile:run:android": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["mobile:sync:android"],
            "options": {
                "command": "node tools/capacitor/run.mjs run control android"
            }
        },
        "mobile:run:ios": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["mobile:sync:ios"],
            "options": {
                "command": "node tools/capacitor/run.mjs run control ios"
            }
        },
        "mobile:clear:android": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "node tools/capacitor/run.mjs clear control android"
            }
        },
        "mobile:clear:ios": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "node tools/capacitor/run.mjs clear control ios"
            }
        }
    }
}
