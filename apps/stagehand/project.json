{
    "name": "stagehand",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/stagehand/src",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "production",
            "options": {
                "baseHref": "./",
                "outputPath": "dist/apps/stagehand",
                "index": "apps/stagehand/src/index.html",
                "browser": "apps/stagehand/src/main.ts",
                "polyfills": [],
                "tsConfig": "apps/stagehand/tsconfig.app.json",
                "fileReplacements": [
                    {
                        "replace": "libs/common/src/lib/settings.ts",
                        "with": "apps/stagehand/src/environments/settings.ts"
                    }
                ],
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/stagehand/public"
                    },
                    {
                        "glob": "*.woff2",
                        "input": "node_modules/material-symbols",
                        "output": "/assets/"
                    },
                    {
                        "glob": "oauth-resp.html",
                        "input": "node_modules/@placeos/ts-client/dist/",
                        "output": "/"
                    },
                    {
                        "glob": "**",
                        "input": "shared/assets",
                        "output": "/assets/"
                    },
                    "apps/stagehand/src/manifest.webmanifest"
                ],
                "styles": [
                    "apps/stagehand/src/styles.css",
                    "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                    "shared/styles/application.css"
                ],
                "scripts": []
            },
            "configurations": {
                "staging": {
                    "optimization": true,
                    "fileReplacements": [
                        {
                            "replace": "apps/stagehand/src/environments/environment.ts",
                            "with": "apps/stagehand/src/environments/environment.prod.ts"
                        },
                        {
                            "replace": "libs/common/src/lib/settings.ts",
                            "with": "apps/stagehand/src/environments/settings.ts"
                        }
                    ],
                    "serviceWorker": "apps/stagehand/ngsw-config.json"
                },
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "libs/mocks/src/index.ts",
                            "with": "libs/mocks/src/empty.ts"
                        },
                        {
                            "replace": "apps/stagehand/src/environments/environment.ts",
                            "with": "apps/stagehand/src/environments/environment.prod.ts"
                        },
                        {
                            "replace": "libs/common/src/lib/settings.ts",
                            "with": "apps/stagehand/src/environments/settings.ts"
                        }
                    ],
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "1mb",
                            "maximumError": "2.5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "16kb"
                        }
                    ],
                    "outputHashing": "all",
                    "serviceWorker": "apps/stagehand/ngsw-config.json"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            }
        },
        "serve": {
            "executor": "@angular/build:dev-server",
            "defaultConfiguration": "development",
            "continuous": true,
            "options": {
                "proxyConfig": "config/proxy.conf.js"
            },
            "configurations": {
                "production": {
                    "buildTarget": "stagehand:build:production"
                },
                "development": {
                    "buildTarget": "stagehand:build:development"
                }
            }
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "stagehand:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": {
            "executor": "@angular/build:unit-test",
            "outputs": ["{workspaceRoot}/coverage/apps/stagehand"],
            "options": {
                "tsConfig": "apps/stagehand/tsconfig.spec.json",
                "setupFiles": ["apps/stagehand/src/test-setup.ts"],
                "isolate": true,
                "watch": false,
                "buildTarget": "stagehand:test-build:development"
            }
        },
        "test-build": {
            "executor": "@angular/build:application",
            "options": {
                "outputPath": "dist/apps/stagehand-test",
                "browser": "apps/stagehand/src/main.ts",
                "tsConfig": "apps/stagehand/tsconfig.spec.json",
                "polyfills": []
            },
            "configurations": {
                "development": {}
            }
        },
        "serve-static": {
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "stagehand:build",
                "port": 4200,
                "staticFilePath": "dist/apps/stagehand/browser",
                "spa": true
            }
        }
    }
}
