{
    "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
    "index": "/index.html",
    "assetGroups": [
        {
            "name": "app",
            "installMode": "prefetch",
            "resources": {
                "files": [
                    "/favicon.ico",
                    "/index.html",
                    "/manifest.webmanifest",
                    "/*.css",
                    "/main-*.js",
                    "/polyfills-*.js"
                ]
            }
        },
        {
            "name": "chunks",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": ["/*.js"]
            }
        },
        {
            "name": "assets",
            "installMode": "lazy",
            "updateMode": "prefetch",
            "resources": {
                "files": [
                    "/assets/**",
                    "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
                ]
            }
        }
    ],
    "dataGroups": [
        {
            "name": "s3",
            "urls": [
                "https://*.amazonaws.com/**/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
            ],
            "cacheConfig": {
                "strategy": "performance",
                "maxSize": 200,
                "maxAge": "7d"
            }
        }
    ]
}
