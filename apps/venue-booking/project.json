{
    "name": "venue-booking",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/venue-booking/src",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/venue-booking",
                "browser": "apps/venue-booking/src/main.ts",
                "polyfills": ["zone.js"],
                "tsConfig": "apps/venue-booking/tsconfig.app.json",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/venue-booking/public"
                    },
                    {
                        "glob": "**",
                        "input": "shared/assets",
                        "output": "/assets/"
                    },
                    {
                        "glob": "*.woff2",
                        "input": "node_modules/material-symbols",
                        "output": "/assets/"
                    },
                    {
                        "glob": "oauth-resp.html",
                        "input": "node_modules/@placeos/ts-client/dist/",
                        "output": "/"
                    },
                    {
                        "glob": "*worker.js",
                        "input": "node_modules/ts-md5/dist/",
                        "output": "/assets"
                    },
                    "apps/venue-booking/src/manifest.webmanifest"
                ],
                "fileReplacements": [
                    {
                        "replace": "libs/common/src/lib/settings.ts",
                        "with": "apps/venue-booking/src/environments/settings.ts"
                    }
                ],
                "styles": [
                    "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                    "apps/venue-booking/src/styles.css",
                    "shared/styles/application.css"
                ]
            },
            "configurations": {
                "staging": {
                    "optimization": true,
                    "fileReplacements": [
                        {
                            "replace": "apps/venue-booking/src/environments/environment.ts",
                            "with": "apps/venue-booking/src/environments/environment.prod.ts"
                        }
                    ],
                    "serviceWorker": "apps/venue-booking/ngsw-config.json"
                },
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "2mb",
                            "maximumError": "5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "6kb",
                            "maximumError": "10kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/venue-booking/src/environments/environment.ts",
                            "with": "apps/venue-booking/src/environments/environment.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "serviceWorker": "apps/venue-booking/ngsw-config.json"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "options": {
                "proxyConfig": "config/proxy.conf.js"
            },
            "configurations": {
                "production": {
                    "buildTarget": "venue-booking:build:production"
                },
                "development": {
                    "buildTarget": "venue-booking:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "venue-booking:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "apps/venue-booking/jest.config.ts"
            }
        },
        "serve-static": {
            "continuous": true,
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "venue-booking:build",
                "port": 4200,
                "staticFilePath": "dist/apps/venue-booking/browser",
                "spa": true
            }
        }
    }
}
