{
    "name": "outlook-addin",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/outlook-addin/src",
    "prefix": "placeos",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "options": {
                "baseHref": "./",
                "outputPath": "dist/apps/outlook-addin",
                "index": "apps/outlook-addin/src/index.html",
                "polyfills": [],
                "tsConfig": "apps/outlook-addin/tsconfig.app.json",
                "fileReplacements": [
                    {
                        "replace": "libs/common/src/lib/settings.ts",
                        "with": "apps/outlook-addin/src/environments/settings.ts"
                    }
                ],
                "assets": [
                    "apps/outlook-addin/src/favicon.ico",
                    "apps/outlook-addin/src/assets",
                    {
                        "glob": "**",
                        "input": "shared/assets",
                        "output": "/assets/"
                    },
                    {
                        "glob": "*.woff2",
                        "input": "node_modules/material-symbols",
                        "output": "/assets/"
                    },
                    {
                        "glob": "oauth-resp.html",
                        "input": "node_modules/@placeos/ts-client/dist/",
                        "output": "/"
                    },
                    "apps/outlook-addin/src/manifest.webmanifest",
                    {
                        "glob": "manifest.xml",
                        "input": "apps/outlook-addin/",
                        "output": "/"
                    },
                    {
                        "glob": "function-file.html",
                        "input": "apps/outlook-addin/src/function-file/",
                        "output": "/function-file"
                    },
                    {
                        "glob": "function-file.ts",
                        "input": "apps/outlook-addin/src/function-file/",
                        "output": "/function-file"
                    }
                ],
                "styles": [
                    "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                    "apps/outlook-addin/src/styles.css",
                    "shared/styles/application.css"
                ],
                "scripts": [],
                "extractLicenses": false,
                "sourceMap": true,
                "optimization": false,
                "namedChunks": true,
                "browser": "apps/outlook-addin/src/main.ts"
            },
            "configurations": {
                "staging": {
                    "optimization": {
                        "fonts": false
                    },
                    "fileReplacements": [
                        {
                            "replace": "apps/outlook-addin/src/environments/environment.ts",
                            "with": "apps/outlook-addin/src/environments/environment.prod.ts"
                        },
                        {
                            "replace": "libs/common/src/lib/settings.ts",
                            "with": "apps/outlook-addin/src/environments/settings.ts"
                        }
                    ],
                    "serviceWorker": "apps/outlook-addin/ngsw-config.json"
                },
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "libs/mocks/src/index.ts",
                            "with": "libs/mocks/src/empty.ts"
                        },
                        {
                            "replace": "apps/outlook-addin/src/environments/environment.ts",
                            "with": "apps/outlook-addin/src/environments/environment.prod.ts"
                        },
                        {
                            "replace": "libs/common/src/lib/settings.ts",
                            "with": "apps/outlook-addin/src/environments/settings.ts"
                        }
                    ],
                    "optimization": {
                        "fonts": false
                    },
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "2mb",
                            "maximumError": "5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "6kb",
                            "maximumError": "10kb"
                        }
                    ],
                    "serviceWorker": "apps/outlook-addin/ngsw-config.json"
                }
            }
        },
        "serve": {
            "executor": "@angular/build:dev-server",
            "continuous": true,
            "options": {
                "proxyConfig": "config/proxy.conf.js",
                "ssl": true,
                "buildTarget": "outlook-addin:build"
            },
            "configurations": {
                "production": {
                    "buildTarget": "outlook-addin:build:production"
                },
                "development": {
                    "buildTarget": "outlook-addin:build:development"
                }
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"]
        },
        "test": {
            "executor": "@angular/build:unit-test",
            "outputs": ["{workspaceRoot}/coverage/apps/outlook-addin"],
            "options": {
                "tsConfig": "apps/outlook-addin/tsconfig.spec.json",
                "setupFiles": ["apps/outlook-addin/src/test-setup.ts"],
                "isolate": true,
                "watch": false,
                "buildTarget": "outlook-addin:test-build:development"
            }
        },
        "test-build": {
            "executor": "@angular/build:application",
            "options": {
                "outputPath": "dist/apps/outlook-addin-test",
                "browser": "apps/outlook-addin/src/main.ts",
                "tsConfig": "apps/outlook-addin/tsconfig.spec.json",
                "polyfills": []
            },
            "configurations": {
                "development": {}
            }
        }
    }
}
