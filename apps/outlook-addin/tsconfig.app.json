{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "types": ["office-js"],
        "experimentalDecorators": true,
        "noEmitOnError": true,
        "sourceMap": true,
        "target": "ES2022",
        "useDefineForClassFields": false
    },
    "ts-node": {
        "files": true
    },
    "types": ["office-js"],
    "angularCompilerOptions": {
        "extendedDiagnostics": {
            "checks": {
                "nullishCoalescingNotNullable": "suppress",
                "optionalChainNotNullable": "suppress"
            }
        }
    },
    "files": ["src/main.ts"],
    "exclude": ["jest.config.ts"]
}
