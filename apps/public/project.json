{
    "name": "public",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "placeos",
    "sourceRoot": "apps/public/src",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/public",
                "browser": "apps/public/src/main.ts",
                "baseHref": "./",
                "tsConfig": "apps/public/tsconfig.app.json",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/public/public"
                    },
                    {
                        "glob": "**",
                        "input": "shared/assets",
                        "output": "/assets/"
                    }
                ],
                "styles": [
                    "apps/public/src/styles.css",
                    "shared/styles/application.css"
                ]
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            },
            "defaultConfiguration": "production"
        },
        "serve": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "configurations": {
                "production": {
                    "proxyConfig": "config/proxy.conf.js",
                    "buildTarget": "public:build:production"
                },
                "development": {
                    "proxyConfig": "config/proxy.conf.js",
                    "buildTarget": "public:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "jestConfig": "apps/public/jest.config.cts",
                "tsConfig": "apps/public/tsconfig.spec.json"
            }
        },
        "serve-static": {
            "continuous": true,
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "public:build",
                "staticFilePath": "dist/apps/public/browser",
                "spa": true
            }
        }
    }
}
