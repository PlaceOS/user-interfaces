{
    "name": "map-studio",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/map-studio/src",
    "prefix": "placeos",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "defaultConfiguration": "production",
            "options": {
                "baseHref": "./",
                "outputPath": "dist/apps/map-studio",
                "index": "apps/map-studio/src/index.html",
                "polyfills": [],
                "tsConfig": "apps/map-studio/tsconfig.app.json",
                "assets": [
                    "apps/map-studio/src/favicon.ico",
                    "apps/map-studio/src/favicon.svg",
                    {
                        "glob": "oauth-resp.html",
                        "input": "node_modules/@placeos/ts-client/dist",
                        "output": "/"
                    },
                    "apps/map-studio/src/assets",
                    {
                        "glob": "**",
                        "input": "shared/assets",
                        "output": "/assets/",
                        "ignore": ["material-symbols*"]
                    },
                    "apps/map-studio/src/manifest.webmanifest"
                ],
                "styles": [
                    "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                    "apps/map-studio/src/styles.css",
                    "shared/assets/material-symbols.css",
                    "shared/styles/application.css"
                ],
                "scripts": [],
                "extractLicenses": false,
                "sourceMap": true,
                "optimization": false,
                "namedChunks": true,
                "browser": "apps/map-studio/src/main.ts"
            },
            "configurations": {
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                },
                "staging": {
                    "fileReplacements": [
                        {
                            "replace": "apps/map-studio/src/environments/environment.ts",
                            "with": "apps/map-studio/src/environments/environment.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "namedChunks": false,
                    "serviceWorker": "apps/map-studio/ngsw-config.json"
                },
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "apps/map-studio/src/environments/environment.ts",
                            "with": "apps/map-studio/src/environments/environment.prod.ts"
                        }
                    ],
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "2mb",
                            "maximumError": "5mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "6kb",
                            "maximumError": "10kb"
                        }
                    ],
                    "serviceWorker": "apps/map-studio/ngsw-config.json"
                }
            }
        },
        "serve": {
            "executor": "@angular/build:dev-server",
            "continuous": true,
            "defaultConfiguration": "development",
            "options": {
                "proxyConfig": "config/proxy.conf.js",
                "buildTarget": "map-studio:build:development"
            },
            "configurations": {
                "development": {
                    "buildTarget": "map-studio:build:development"
                },
                "production": {
                    "buildTarget": "map-studio:build:production"
                }
            }
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "map-studio:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"]
        },
        "test": {
            "executor": "@angular/build:unit-test",
            "outputs": ["{workspaceRoot}/coverage/apps/map-studio"],
            "options": {
                "tsConfig": "apps/map-studio/tsconfig.spec.json",
                "watch": false
            },
            "configurations": {
                "ci": {
                    "coverage": true
                }
            }
        }
    }
}
