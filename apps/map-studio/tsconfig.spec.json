{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "module": "preserve",
        "types": ["vitest/globals", "node"],
        "moduleResolution": "bundler",
        "target": "ES2022",
        "useDefineForClassFields": false
    },
    "include": ["**/*.spec.ts", "**/*.test.ts", "**/*.d.ts"]
}
