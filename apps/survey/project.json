{
    "name": "survey",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/survey/src",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular/build:application",
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "production",
            "options": {
                "outputPath": "dist/apps/survey",
                "browser": "apps/survey/src/main.ts",
                "polyfills": [],
                "baseHref": "./",
                "tsConfig": "apps/survey/tsconfig.app.json",
                "assets": [
                    {
                        "glob": "**/*",
                        "input": "apps/survey/public"
                    },
                    {
                        "glob": "**",
                        "input": "shared/assets",
                        "output": "/assets/"
                    },
                    {
                        "glob": "*.woff2",
                        "input": "node_modules/material-symbols",
                        "output": "/assets/"
                    },
                    {
                        "glob": "oauth-resp.html",
                        "input": "node_modules/@placeos/ts-client/dist/",
                        "output": "/"
                    }
                ],
                "styles": [
                    "apps/survey/src/styles.css",
                    "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                    "shared/styles/application.css"
                ],
                "serviceWorker": "apps/survey/ngsw-config.json"
            },
            "configurations": {
                "production": {
                    "fileReplacements": [
                        {
                            "replace": "apps/survey/src/environments/environment.ts",
                            "with": "apps/survey/src/environments/environment.prod.ts"
                        },
                        {
                            "replace": "libs/common/src/lib/settings.ts",
                            "with": "apps/survey/src/environments/settings.ts"
                        }
                    ],
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1.8mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "4kb",
                            "maximumError": "8kb"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            }
        },
        "serve": {
            "continuous": true,
            "executor": "@angular/build:dev-server",
            "defaultConfiguration": "development",
            "configurations": {
                "production": {
                    "proxyConfig": "config/proxy.conf.js",
                    "buildTarget": "survey:build:production"
                },
                "development": {
                    "proxyConfig": "config/proxy.conf.js",
                    "buildTarget": "survey:build:development"
                }
            }
        },
        "extract-i18n": {
            "executor": "@angular/build:extract-i18n",
            "options": {
                "buildTarget": "survey:build"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        },
        "test": {
            "executor": "@angular/build:unit-test",
            "outputs": ["{workspaceRoot}/coverage/apps/survey"],
            "options": {
                "tsConfig": "apps/survey/tsconfig.spec.json",
                "setupFiles": ["apps/survey/src/test-setup.ts"],
                "isolate": true,
                "watch": false,
                "buildTarget": "survey:test-build:development"
            }
        },
        "test-build": {
            "executor": "@angular/build:application",
            "options": {
                "outputPath": "dist/apps/survey-test",
                "browser": "apps/survey/src/main.ts",
                "tsConfig": "apps/survey/tsconfig.spec.json",
                "polyfills": []
            },
            "configurations": {
                "development": {}
            }
        },
        "serve-static": {
            "continuous": true,
            "executor": "@nx/web:file-server",
            "options": {
                "buildTarget": "survey:build",
                "port": 4200,
                "staticFilePath": "dist/apps/survey/browser",
                "spa": true
            }
        },
        "e2e": {
            "executor": "@nx/playwright:playwright",
            "outputs": ["{workspaceRoot}/dist/.playwright/apps/survey"],
            "options": {
                "config": "apps/survey/playwright.config.ts"
            }
        }
    }
}
