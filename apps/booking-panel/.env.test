# Loaded by Nx only for the `test` target (see Nx per-target .env convention).
# Selects the `[test]` section of .browserslistrc so the zoneless unit-test
# build targets a modern engine that supports top-level await (the app's
# production browserslist still targets Chrome 80, which esbuild rejects for
# the test-bed-init's `await import('zone.js/testing')`).
BROWSERSLIST_ENV=test
