{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/config-schema.json",
    // The add-in package.json only serves its manual webpack dev server.
    // The Angular app resolves packages from the root package.json.
    "ignorePatterns": ["apps/outlook-addin/package.json"],
    "dynamicallyLoaded": [
        "apps/**/src/environments/*.ts",
        "apps/**/src/test-setup.ts",
        "apps/**/src/index.html",
        "apps/**/src/manifest.webmanifest",
        "apps/outlook-addin/commands/commands.ts",
        "apps/outlook-addin/lib/**/*.js",
        "apps/outlook-addin/src/function-file/**/*.js",
        "apps/outlook-addin/taskpane/taskpane.ts",
        "config/proxy.conf.js",
        "jest.preset.js",
        "libs/**/src/lib/**/*.ts",
        "libs/**/src/test-setup.ts",
        "libs/mocks/src/empty.ts",
        "libs/mocks/src/mocks.ts",
        "shared/assets/**",
        "shared/styles/**",
        "tools/**/*.js",
        "tools/**/*.mjs"
    ],
    "ignoreDependencies": [
        "@nrwl/cli",
        "angular",
        "angular-animate",
        "angular-route",
        "angular-sanitize",
        "core-js",
        "fs-extra",
        "regenerator-runtime",
        // Declared in apps/outlook-addin/package.json for its webpack dev server
        "copy-webpack-plugin",
        "office-addin-dev-certs",
        // Root folder imported through the tsconfig baseUrl, not a package
        "shared",
        // Installed transitively by @capacitor/assets
        "sharp"
    ],
    "ignoreExports": [
        {
            "file": "libs/**/src/index.ts",
            "exports": ["*"]
        },
        {
            "file": "libs/**/src/lib/**/*.ts",
            "exports": ["*"]
        },
        {
            "file": "libs/**/src/tests/**/*.ts",
            "exports": ["*"]
        },
        {
            "file": "apps/**/e2e/test-utils.ts",
            "exports": ["*"]
        },
        {
            "file": "apps/outlook-addin/src/tests/test-mocks.ts",
            "exports": ["*"]
        }
    ],
    "rules": {
        "unused-class-members": "off",
        "unused-dev-dependencies": "off",
        "unresolved-imports": "off",
        "duplicate-exports": "off",
        "circular-dependencies": "off",
        // Applications are bundled, so the dependency section has no runtime effect
        "dev-dependencies-in-production": "off"
    },
    "overrides": [
        {
            // Spec files declare stub components that mirror the real API
            "files": [
                "**/*.spec.ts",
                "apps/*/src/tests/**",
                "libs/*/src/test/**",
                "libs/*/src/tests/**"
            ],
            "rules": {
                "unused-component-inputs": "off",
                "unused-component-outputs": "off"
            }
        }
    ]
}
