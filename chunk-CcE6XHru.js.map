{
    "type": "object",
    "description": "Customisable settings for the stagehand app",
    "properties": {
        "name": {
            "type": "string",
            "description": "Application name for the PlaceOS API client. If the URL pathname is empty, the app also uses this name to make the settings metadata key"
        },
        "short_name": {
            "type": "string",
            "description": "Prefix for console log messages. The app also uses it as the API client application name if `name` is not set"
        },
        "access_subsystem": {
            "type": "string",
            "description": "Group subsystem that grants access to the app, when the authority's `use_group_subsystem_access` is on. Defaults to `support`"
        },
        "allow_dark_mode": {
            "type": "boolean",
            "description": "Make the dark theme control available in the sidebar. When off or not set, the app uses the light theme"
        },
        "chat": {
            "type": "object",
            "description": "Chat widget settings",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Whether to show the chat widget. Defaults to off when not set"
                }
            }
        },
        "push_notification_defaults": {
            "type": "object",
            "description": "Default push notification enablement per alert severity level. Merged with the user's saved preferences, which take priority",
            "properties": {
                "critical": {
                    "type": "boolean",
                    "description": "Whether push notifications for critical alerts are enabled by default"
                },
                "high": {
                    "type": "boolean",
                    "description": "Whether push notifications for high severity alerts are enabled by default"
                },
                "medium": {
                    "type": "boolean",
                    "description": "Whether push notifications for medium severity alerts are enabled by default"
                },
                "low": {
                    "type": "boolean",
                    "description": "Whether push notifications for low severity alerts are enabled by default"
                }
            }
        },
        "educational_environment": {
            "type": "boolean",
            "description": "Whether the app is used in an educational environment. When set, room events are labelled as classes, e.g. `Current Class` instead of `Current Event`"
        },
        "snapshot_interval": {
            "type": "number",
            "description": "Time in milliseconds between refreshes of camera snapshot images. Defaults to `10000` (10 seconds)"
        },
        "analytics_pages": {
            "type": "array",
            "description": "List of analytics dashboards selectable on the analytics page, each embedded in an iframe. The analytics link is only shown in the sidebar when this list is not empty",
            "items": {
                "type": "object",
                "required": ["name", "url"],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Display name for the analytics dashboard"
                    },
                    "url": {
                        "type": "string",
                        "description": "URL of the analytics dashboard to embed"
                    }
                }
            }
        },
        "backoffice_link": {
            "type": "string",
            "description": "Base URL of the PlaceOS Backoffice, used for links to view systems and triggers. Defaults to `/backoffice/` on the current origin"
        },
        "service_link": {
            "type": "string",
            "description": "Base URL of the room control UI, used for links to control a room. Defaults to `/control/` on the current origin"
        },
        "show_recorder_view": {
            "type": "boolean",
            "description": "Whether to show the recorder streams link in the sidebar"
        }
    }
}
