        "**/user-state.ts"
    ],
    "trustedDependencies": [
        "@parcel/watcher",
        "@sentry/cli",
        "@swc/core",
        "core-js",
        "esbuild",
        "lmdb",
        "msgpackr-extract",
        "nx",
        "sharp",
