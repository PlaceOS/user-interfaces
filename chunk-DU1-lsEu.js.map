{
    "type": "object",
    "description": "Customisable settings for the timetable app",
    "properties": {
        "name": {
            "type": "string",
            "description": "Application name for the PlaceOS API client. If the URL pathname is empty, the app also uses this name to make the settings metadata key"
        },
        "short_name": {
            "type": "string",
            "description": "Prefix for console log messages. The app also uses it as the API client application name if `name` is not set"
        },
        "logo_light": {
            "description": "Logo displayed in the top bar when the light theme is active. Either an image URL string or an object with a `src` URL",
            "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/logo" }]
        },
        "logo_dark": {
            "description": "Logo displayed in the top bar when the dark theme is active. Either an image URL string or an object with a `src` URL. Needs `allow_dark_mode`",
            "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/logo" }]
        },
        "allow_dark_mode": {
            "type": "boolean",
            "description": "Allow the dark theme. When on, the app uses the theme saved in the user's settings. When off or not set, the app uses the light theme"
        },
        "block_start": {
            "type": "number",
            "description": "First hour of the day (0-23) displayed on the timetable grid. Defaults to `0`"
        },
        "block_end": {
            "type": "number",
            "description": "Last hour of the day (1-24) displayed on the timetable grid. The app always shows at least one hour after `block_start`. Defaults to `24`"
        },
        "use_24_hour_time": {
            "type": "boolean",
            "description": "Whether to show times in 24-hour format. Defaults to `false`"
        },
        "eink_mode": {
            "type": "boolean",
            "description": "Whether to limit screen updates for e-ink panels. The clock and current-time line update once per minute and animations are off. The `eink` URL query parameter overrides this setting. Defaults to `false`"
        },
        "page_interval": {
            "type": "number",
            "description": "Seconds between pages when more spaces are selected than fit on the screen. Set to `0` to scroll instead. E-ink mode uses a minimum of 60 seconds. Defaults to `20`"
        },
        "night_mode": {
            "type": "boolean",
            "description": "Whether to cover the grid with a dark screen and a small clock outside the displayed hours. Defaults to `false`"
        },
        "burn_in_protection": {
            "type": "boolean",
            "description": "Whether to move the UI by a few pixels every 10 minutes to prevent screen burn-in. Not used in e-ink mode. Defaults to `false`"
        },
        "analytics": {
            "type": "object",
            "description": "Google Analytics settings",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Whether Google Analytics tracking is enabled"
                },
                "tracking_id": {
                    "type": "string",
                    "description": "Google Analytics tracking ID. Analytics is only initialised when this is set"
                }
            }
        }
    },
    "$defs": {
        "logo": {
            "type": "object",
            "required": ["src"],
            "properties": {
                "src": {
                    "type": "string",
                    "description": "URL of the logo image"
                }
            }
        }
    }
}
