{
    "name": "events",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/events/src",
    "prefix": "placeos",
    "tags": [],
    "targets": {
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"]
        },
        "test": {
            "executor": "@angular/build:unit-test",
            "outputs": ["{workspaceRoot}/coverage/libs/events"],
            "options": {
                "tsConfig": "libs/events/tsconfig.spec.json",
                "setupFiles": ["libs/events/src/test-setup.ts"],
                "isolate": true,
                "watch": false,
                "buildTarget": "events:test-build:development"
            }
        },
        "test-build": {
            "executor": "@angular/build:application",
            "options": {
                "outputPath": "dist/libs/events",
                "browser": "libs/events/src/index.ts",
                "tsConfig": "libs/events/tsconfig.spec.json",
                "polyfills": []
            },
            "configurations": {
                "development": {}
            }
        }
    }
}
